# Copy this file to .env and fill real values
PORT=5000
MONGODB_URI=your-mongodb-connection-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_TO=
FRONTEND_URL=http://localhost:5173
NODE_ENV=development                                                                                                                                                                                    

# Razorpay (keep the secret server-side; never expose it in VITE_* variables)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =========================================================
# Real SMS Gateway for Sending Mobile SMS OTPs (Choose one)
# =========================================================
# Option 1: Fast2SMS (Recommended for Indian numbers - https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Option 2: 2Factor.in (https://2factor.in)
TWOFACTOR_API_KEY=

# Option 3: Twilio (Global SMS - https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

